{
  "training": {
    "batch_size": 8,
    "learning_rate": 1e-4,
    "weight_decay": 5e-4,
    "num_epochs": 50,
    "optimizer": "adam",
    "num_workers": 2
  },
  "alexnet_detector": {
    "num_classes": 96,
    "num_boxes": 10,
    "lambda_cls": 1.0,
    "lambda_loc": 1.0,
    "dropout": 0.5,
    "pretrained": true
  },
  "rcnn": {
    "num_classes": 96,
    "max_proposals": 2000,
    "iou_threshold_positive": 0.5,
    "iou_threshold_negative": 0.3,
    "nms_iou_threshold": 0.5,
    "backbone": "alexnet",
    "pretrained": true
  },
  "data_augmentation": {
    "horizontal_flip_prob": 0.5,
    "rotation_range": 15,
    "brightness_range": [0.8, 1.2],
    "contrast_range": [0.8, 1.2]
  },
  "data": {
    "target_size": [640, 640],
    "normalization_mean": [0.485, 0.456, 0.406],
    "normalization_std": [0.229, 0.224, 0.225]
  },
  "class_balancing": {
    "use_weighted_sampling": false,
    "oversample_minority_threshold": 100
  }
}
